{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "openhub-github-auth",
	"main": "src/worker.js",
	"compatibility_date": "2026-05-29",
	"workers_dev": true,
	"preview_urls": true,
	"routes": [
		{
			"pattern": "openhub.moomer.ccwu.cc",
			"custom_domain": true
		}
	],
	"vars": {
		"GITHUB_APP_NAME": "OpenHub",
		"GITHUB_APP_ID": "3896773",
		"GITHUB_CLIENT_ID": "Iv23liSGZCcpye50unTb",
		"APP_REDIRECT_URI": "openhub://auth/callback"
	},
	"kv_namespaces": [
		{
			"binding": "OPENHUB_KV",
			"id": "0be6d3ed5b684b33883fdcb45d87eacb"
		}
	],
	"d1_databases": [
		{
			"binding": "OPENHUB_DB",
			"database_name": "openhub",
			"database_id": "917f029b-6a45-4f55-b711-8e8710f5af87"
		}
	]
}
